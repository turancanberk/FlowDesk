<Project>

  <!--
    Merkezî paket sürüm yönetimi (ADR-0016).
    Sürümler yalnızca burada tanımlanır; .csproj dosyalarında Version verilmez.
    Tüm sürümler resmî NuGet registry'sinden doğrulanmış stable sürümlerdir.
  -->
  <PropertyGroup>
    <ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>
  </PropertyGroup>

  <ItemGroup Label="ASP.NET Core">
    <PackageVersion Include="Microsoft.AspNetCore.OpenApi" Version="10.0.12" />
  </ItemGroup>

  <ItemGroup Label="Barındırma">
    <PackageVersion Include="Microsoft.Extensions.Hosting" Version="10.0.12" />
  </ItemGroup>

  <ItemGroup Label="Veri erişimi">
    <PackageVersion Include="Microsoft.EntityFrameworkCore" Version="10.0.12" />
    <PackageVersion Include="Microsoft.EntityFrameworkCore.Design" Version="10.0.12" />
    <PackageVersion Include="Microsoft.EntityFrameworkCore.Relational" Version="10.0.12" />
    <PackageVersion Include="Npgsql" Version="10.0.3" />
    <PackageVersion Include="Npgsql.EntityFrameworkCore.PostgreSQL" Version="10.0.3" />
  </ItemGroup>

  <ItemGroup Label="Kimlik doğrulama">
    <PackageVersion Include="Microsoft.AspNetCore.Identity.EntityFrameworkCore" Version="10.0.12" />
    <PackageVersion Include="Microsoft.AspNetCore.Authentication.JwtBearer" Version="10.0.12" />
    <PackageVersion Include="Microsoft.IdentityModel.JsonWebTokens" Version="8.22.0" />
  </ItemGroup>

  <!--
    RabbitMQ.Client 7.x tamamen async bir API'dir; 6.x için yazılmış örnekler
    derlenmez. Sürüm kurulum anında resmî NuGet registry'sinden doğrulandı
    (ADR-0016).
  -->
  <ItemGroup Label="Mesajlaşma">
    <PackageVersion Include="RabbitMQ.Client" Version="7.2.2" />
  </ItemGroup>

  <!--
    MailKit, .NET'in kullanımdan kaldırılmış SmtpClient'ı yerine kullanılıyor:
    o sınıfın kendi belgesi modern protokoller için önerilmediğini söylüyor.
    Sürüm kurulum anında resmî NuGet registry'sinden doğrulandı (ADR-0016).
  -->
  <ItemGroup Label="E-posta">
    <PackageVersion Include="MailKit" Version="4.18.0" />
  </ItemGroup>

  <ItemGroup Label="Dosya depolama">
    <PackageVersion Include="Azure.Storage.Blobs" Version="12.29.2" />
  </ItemGroup>

  <ItemGroup Label="Doğrulama">
    <PackageVersion Include="FluentValidation" Version="12.1.1" />
    <PackageVersion Include="FluentValidation.DependencyInjectionExtensions" Version="12.1.1" />
  </ItemGroup>

  <!--
    Infrastructure katmanı ASP.NET Core shared framework'üne bağımlı değildir.
    Yalnızca ihtiyaç duyduğu soyutlama paketleri alınır; böylece web katmanı
    endişeleri altyapıya sızmaz (ADR-0001).
  -->
  <ItemGroup Label="Extensions soyutlamaları">
    <PackageVersion Include="Microsoft.Extensions.Configuration.Abstractions" Version="10.0.12" />
    <PackageVersion Include="Microsoft.Extensions.DependencyInjection.Abstractions" Version="10.0.12" />
    <PackageVersion Include="Microsoft.Extensions.Diagnostics.HealthChecks" Version="10.0.12" />
    <PackageVersion Include="Microsoft.Extensions.Diagnostics.HealthChecks.Abstractions" Version="10.0.12" />
    <PackageVersion Include="Microsoft.Extensions.Hosting.Abstractions" Version="10.0.12" />
    <PackageVersion Include="Microsoft.Extensions.Logging.Abstractions" Version="10.0.12" />
    <PackageVersion Include="Microsoft.Extensions.Options.ConfigurationExtensions" Version="10.0.12" />
    <PackageVersion Include="Microsoft.Extensions.Options.DataAnnotations" Version="10.0.12" />
  </ItemGroup>

  <!--
    xUnit v3 Microsoft.Testing.Platform üzerine kuruludur ve test projesini
    kendi çalıştırıcısıyla çalıştırılabilir olarak derler. Bu yüzden VSTest
    tarafı paketlere (Microsoft.NET.Test.Sdk, xunit.runner.visualstudio,
    coverlet.collector) ihtiyaç yoktur. Çalıştırıcı seçimi kökteki
    global.json içindedir.
  -->
  <ItemGroup Label="Test">
    <PackageVersion Include="xunit.v3" Version="4.0.1" />
    <PackageVersion Include="Microsoft.AspNetCore.Mvc.Testing" Version="10.0.12" />
    <PackageVersion Include="Testcontainers.PostgreSql" Version="4.15.0" />
    <PackageVersion Include="Testcontainers.RabbitMq" Version="4.15.0" />
  </ItemGroup>

</Project>
