# ============================================================================
# FlowDesk — Ortam Değişkenleri Şablonu
# ----------------------------------------------------------------------------
# Bu dosya depoya commit EDİLİR ve yalnızca ÖRNEK değerler içerir.
# Gerçek kullanım için kopyalayın:  cp .env.example .env
# .env dosyası .gitignore ile hariç tutulmuştur ve asla commit edilmez.
#
# Üretimde bu değerler ortam değişkeni yöneticisi veya GitHub Secrets ile
# sağlanır; dosyadan okunmaz ve imaja gömülmez.
# ============================================================================

# ----------------------------------------------------------------------------
# Port haritası
# ----------------------------------------------------------------------------
# Not: Bu makinede 5432, 6379 ve 5000 başka süreçler tarafından kullanıldığı
# için varsayılanlar bilinçli olarak kaydırılmıştır.
FLOWDESK_WEB_PORT=3000
FLOWDESK_API_HTTP_PORT=5080
FLOWDESK_API_HTTPS_PORT=5443
POSTGRES_PORT=5433

# Aşağıdaki servisler ilgili faz geldiğinde devreye alınır (kademeli altyapı).
# Faz 10 — RabbitMQ
RABBITMQ_PORT=5672
RABBITMQ_MANAGEMENT_PORT=15672
# Faz 12 — Mailpit
MAILPIT_SMTP_PORT=1025
MAILPIT_UI_PORT=8025
# Faz 13 — Azurite
AZURITE_BLOB_PORT=10000
AZURITE_QUEUE_PORT=10001
AZURITE_TABLE_PORT=10002
# Faz 15 — Redis
REDIS_PORT=6380
# Faz 18 — Gözlemlenebilirlik
PROMETHEUS_PORT=9090
GRAFANA_PORT=3001

# ----------------------------------------------------------------------------
# PostgreSQL (Faz 01)
# ----------------------------------------------------------------------------
POSTGRES_DB=flowdesk
POSTGRES_USER=flowdesk
# ÖRNEK DEĞER — yerel geliştirme dışında kullanmayın, üretimde değiştirin.
POSTGRES_PASSWORD=degistir_beni_local_dev

# Backend bağlantı dizesi. Yerelde docker compose ile ayağa kalkan PostgreSQL'e
# host üzerinden POSTGRES_PORT ile bağlanılır.
# Çift alt çizgi, yapılandırma bölümü ayracıdır: Postgres:ConnectionString
# Değer tırnak içindedir: noktalı virgül tırnaksızken shell tarafından komut
# ayracı sayılır ve `set -a; . ./.env` ile okunduğunda dize kırpılır.
Postgres__ConnectionString="Host=localhost;Port=5433;Database=flowdesk;Username=flowdesk;Password=degistir_beni_local_dev"

# ----------------------------------------------------------------------------
# RabbitMQ (Faz 10)
# ----------------------------------------------------------------------------
RABBITMQ_USER=flowdesk
# ÖRNEK DEĞER — yerel geliştirme dışında kullanmayın, üretimde değiştirin.
RABBITMQ_PASSWORD=degistir_beni_local_dev
RABBITMQ_VHOST=/

# Uygulama tarafı bağlantısı. Değer tırnak içinde değil; içinde noktalı virgül
# yok, ancak parola gerçek bir değerle değiştirildiğinde özel karakter
# içeriyorsa tırnaklayın.
Messaging__Host=localhost
Messaging__Port=5672
Messaging__VirtualHost=/
Messaging__UserName=flowdesk
Messaging__Password=degistir_beni_local_dev
# Yayınlanan tüm mesajların gittiği exchange. Kuyruklar buradan bağlanır.
Messaging__ExchangeName=flowdesk.events

# ----------------------------------------------------------------------------
# Outbox (Faz 11)
# ----------------------------------------------------------------------------
# Use case'ler mesajı doğrudan göndermez; kendi transaction'ları içinde bir
# satır yazar. Aşağıdaki ayarlar bu satırları broker'a taşıyan Worker
# işleyicisinin temposunu belirler (ADR-0033).
Outbox__PollIntervalSeconds=5
Outbox__BatchSize=20
Outbox__RetryBaseSeconds=10
Outbox__RetryMaximumSeconds=900

# ----------------------------------------------------------------------------
# E-posta (Faz 12)
# ----------------------------------------------------------------------------
# Yerelde Mailpit; hiçbir posta dışarı çıkmaz. Üretimde gerçek bir SMTP
# sağlayıcısı kullanılır ve kimlik bilgileri ortam değişkeni / GitHub Secrets
# ile verilir, bu dosyadan okunmaz.
Email__Host=localhost
Email__Port=1025
Email__UseStartTls=false
Email__UserName=
Email__Password=
Email__FromAddress=bildirim@flowdesk.test
Email__FromDisplayName=FlowDesk
# Davet ve bildirim bağlantılarının gösterileceği adres.
Email__WebBaseUrl=http://localhost:3000

# ----------------------------------------------------------------------------
# Dosya depolama (Faz 13)
# ----------------------------------------------------------------------------
# Aşağıdaki anahtar Azurite'in herkesçe bilinen, belgelenmiş geliştirme
# hesabıdır. Gizli değildir, gizli olması da amaçlanmamıştır ve yalnızca yerel
# öykünücüde geçerlidir. Üretimde gerçek bağlantı dizesi ortam değişkeni veya
# GitHub Secrets ile verilir, bu dosyadan okunmaz.
Storage__ConnectionString="DefaultEndpointsProtocol=http;AccountName=devstoreaccount1;AccountKey=Eby8vdM02xNOcqFlqUwJPLlmEtlCDXJ1OUzFT50uSRZ6IFsuFq2UVErCz4I6tq/K1SZFPTOtr/KBHBeksoGMGw==;BlobEndpoint=http://localhost:10000/devstoreaccount1;"
Storage__ContainerName=flowdesk-attachments
# Yükleme sınırı. Uygulama ve sunucu tarafında ayrı ayrı zorlanır.
Storage__MaximumFileSizeBytes=10485760

# ----------------------------------------------------------------------------
# Önbellek (Faz 15)
# ----------------------------------------------------------------------------
# Yalnızca dashboard toplamları için (ADR-0015). Redis erişilemezse uygulama
# çalışmaya devam eder, yalnızca önbellek faydasını kaybeder.
Cache__ConnectionString=localhost:6380
# Dashboard'un ne kadar bayat olabileceği.
Cache__DashboardTtlSeconds=60

# --- Gözlemlenebilirlik (Faz 18) -------------------------------------------
# Metrikler OTLP ile Prometheus'a gönderilir. Prometheus ve Grafana
# "observability" profilinin arkasındadır; profil kapalıyken bu adres
# erişilemez olur ve metrikler yalnızca dışa aktarılmaz — uygulama çalışmaya
# devam eder.
Observability__MetricsOtlpEndpoint=http://localhost:9090/api/v1/otlp/v1/metrics
Observability__MetricsExportIntervalSeconds=15

# Grafana yönetici parolası. Gerçek bir parola depoya yazılmaz.
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=degistir_beni_local_dev

# ----------------------------------------------------------------------------
# Kimlik doğrulama (Faz 03)
# ----------------------------------------------------------------------------
# ÖRNEK DEĞER. Gerçek anahtar en az 32 bayt rastgele olmalıdır:
#   openssl rand -base64 48
# Yerelde .NET user-secrets, üretimde ortam değişkeni/GitHub Secrets kullanın.
Auth__SigningKey=ORNEK_DEGER_URETIMDE_KULLANMAYIN_en_az_32_karakter_olmali
Auth__Issuer=flowdesk-api
Auth__Audience=flowdesk-web
Auth__AccessTokenLifetimeMinutes=10
Auth__RefreshTokenLifetimeDays=14
# Çerez güvenlik politikası: Always | SameAsRequest
# Üretimde Always olmak zorundadır; aksi halde uygulama başlamaz.
Auth__Cookies__SecurePolicy=Always

# ----------------------------------------------------------------------------
# CORS (Faz 03)
# ----------------------------------------------------------------------------
# Yalnızca bilinen frontend origin'i. Joker (*) kullanılmaz.
# Üretimde frontend ve API aynı origin altında sunulur, bu değer boş kalabilir.
Cors__AllowedOrigins__0=http://localhost:3000

# ----------------------------------------------------------------------------
# Frontend
# ----------------------------------------------------------------------------
NEXT_PUBLIC_API_BASE_URL=http://localhost:5080
